# Web UI login (auth.js) - copy to .env in the repo root (gitignored) and fill in.
# Both WEB_USER and WEB_PASSWORD are required to turn the login on; with both
# absent the pages are open (local development); only one of them stops the server.
# Real environment variables take precedence over this file. Restart the server
# after changing it.
WEB_USER=admin
WEB_PASSWORD=change-me-to-a-long-passphrase

# Optional: fixed session-cookie secret, at least 32 bytes (64 hex characters or a
# long passphrase); SESSION_SECRET is accepted as the name too. Unset = generated
# once into config/session.secret.
#WEB_SESSION_SECRET=

# Optional: which reverse proxy's X-Forwarded-* headers to trust for the client
# address (login lockout) and the HTTPS flag. Default loopback = a proxy on this
# machine; an address/CIDR, "true" (any proxy) or "false" (none) also work.
#WEB_TRUST_PROXY=loopback
